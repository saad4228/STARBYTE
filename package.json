{
  "name": "starbyte-watch-party",
  "private": true,
  "version": "0.1.0",
  "description": "STARBYTE — Watch Party. A multiplayer media room: your screen, their reactions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
